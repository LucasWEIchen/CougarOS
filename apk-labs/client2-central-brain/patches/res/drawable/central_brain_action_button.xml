<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="#C8D9DEE2" />
            <stroke android:width="1.0dp" android:color="#80818A91" />
            <corners android:radius="4.0dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#E8FFFFFF" />
            <stroke android:width="1.0dp" android:color="#66818A91" />
            <corners android:radius="4.0dp" />
        </shape>
    </item>
</selector>
