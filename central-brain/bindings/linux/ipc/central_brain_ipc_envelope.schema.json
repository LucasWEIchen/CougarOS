{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "central_brain_ipc_envelope.schema.json",
  "title": "Central Brain Linux IPC Envelope",
  "description": "Unix domain socket JSON envelope for XSC-006 and NV-P-002 Linux IPC binding.",
  "type": "object",
  "required": ["trace_id", "operation", "payload"],
  "properties": {
    "trace_id": {
      "type": "string"
    },
    "operation": {
      "type": "string",
      "enum": [
        "uib.context.get",
        "uib.state.get",
        "uib.events.topics",
        "uib.events.publish",
        "uib.events.recent",
        "uib.events.subscriptions.get",
        "uib.events.subscriptions.request",
        "uib.events.subscriptions.cancel",
        "uib.events.subscriptions.transport.readiness",
        "uib.events.subscriptions.decision.matrix",
        "uib.events.subscriptions.activation.checklist",
        "uib.events.subscriptions.callback.watch.shape",
        "uib.extensions.get",
        "uib.actions.request",
        "ai.sdk.capabilities",
        "agent.plan",
        "agent.execute",
        "skills.list",
        "skills.invoke",
        "memory.query",
        "soa.services.list",
        "soa.contracts.get",
        "soa.service.invoke",
        "policy.evaluate",
        "governance.precheck",
        "governance.backend.contract.get",
        "governance.migration.check",
        "governance.deployment.plan.get",
        "governance.runtime.get",
        "audit.recent.get",
        "bindings.list",
        "bindings.readiness.get",
        "delivery.readiness.get",
        "prototype.readiness.get",
        "hardware.interfaces.get",
        "vehicle.signals.list",
        "vehicle.signals.activation.get",
        "vehicle.signals.validation.get"
      ]
    },
    "caller": {
      "type": "object",
      "additionalProperties": true
    },
    "permission_context": {
      "type": "object",
      "additionalProperties": true
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "req_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "contains": {
        "const": "XSC-006"
      }
    }
  },
  "additionalProperties": false
}
