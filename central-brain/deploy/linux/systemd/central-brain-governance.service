[Unit]
Description=Central Brain Linux Runtime & Governance socket sample
Documentation=file:/opt/central-brain/appDev/docs/CENTRAL_BRAIN_PLATFORM_DELTA.md

[Service]
Type=simple
User=centralbrain
Group=centralbrain
WorkingDirectory=/opt/central-brain/appDev
EnvironmentFile=-/etc/central-brain/central-brain.env
Environment=CENTRAL_BRAIN_GOVERNANCE_SOCKET=/run/central-brain/governance.sock
Environment=CENTRAL_BRAIN_GOVERNANCE_AUDIT_LOG=/var/log/central-brain/governance-audit.jsonl
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=central-brain
RuntimeDirectoryMode=0770
LogsDirectory=central-brain
UMask=0007
ExecStart=/usr/bin/python3 /opt/central-brain/appDev/central-brain/bindings/linux/ipc/central_brain_governance_daemon.py --socket-path ${CENTRAL_BRAIN_GOVERNANCE_SOCKET}
Restart=on-failure
RestartSec=2
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
ReadWritePaths=/run/central-brain /var/log/central-brain

[Install]
WantedBy=multi-user.target
