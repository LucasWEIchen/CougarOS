# Central Brain Linux deployment environment.
# Req IDs: DEL-002, DEL-003, DEL-004, XSC-002, XSC-003, XSC-005, XSC-006, NV-P-002, NV-P-003.

CENTRAL_BRAIN_PORT=8787
CENTRAL_BRAIN_BASE_URL=http://127.0.0.1:8787
CENTRAL_BRAIN_IPC_SOCKET=/run/central-brain/gateway.sock
CENTRAL_BRAIN_GRPC_HOST=127.0.0.1
CENTRAL_BRAIN_GRPC_PORT=18788
CENTRAL_BRAIN_GOVERNANCE_SOCKET=/run/central-brain/governance.sock
CENTRAL_BRAIN_AUDIT_LOG=/var/log/central-brain/audit.jsonl
CENTRAL_BRAIN_IPC_AUDIT_LOG=/var/log/central-brain/ipc-audit.jsonl
CENTRAL_BRAIN_GRPC_AUDIT_LOG=/var/log/central-brain/grpc-audit.jsonl
CENTRAL_BRAIN_GOVERNANCE_AUDIT_LOG=/var/log/central-brain/governance-audit.jsonl

# Optional user-space simulated NPU backend. Keep mock unless Ollama is deployed.
# CENTRAL_BRAIN_SIMULATED_NPU_BACKEND=ollama
# CENTRAL_BRAIN_OLLAMA_URL=http://127.0.0.1:11434
# CENTRAL_BRAIN_OLLAMA_MODEL=qwen3.5:27b-optimized
# CENTRAL_BRAIN_OLLAMA_TIMEOUT_MS=90000
# CENTRAL_BRAIN_OLLAMA_NUM_PREDICT=64
# CENTRAL_BRAIN_OLLAMA_THINK=false
