{
  "profile_id": "central-brain-linux-systemd-profile",
  "version": "0.1",
  "status": "sample-profile",
  "req_ids": [
    "DEL-002",
    "DEL-003",
    "DEL-004",
    "XSC-005",
    "XSC-006",
    "NV-P-002",
    "NV-P-003",
    "NV-G-007"
  ],
  "target": {
    "platform": "linux-cockpit-domain",
    "install_root": "/opt/central-brain/appDev",
    "environment_file": "/etc/central-brain/central-brain.env",
    "service_user": "centralbrain",
    "service_group": "centralbrain",
    "runtime_directory": "/run/central-brain",
    "log_directory": "/var/log/central-brain"
  },
  "services": [
    {
      "name": "central-brain-backend",
      "unit": "central-brain-backend.service",
      "role": "semantic-gateway-rest-prototype",
      "exec_contains": "tools/run_central_brain_backend.sh",
      "requires_runtime_directory": false,
      "write_paths": [
        "/var/log/central-brain"
      ],
      "req_ids": [
        "DEL-002",
        "DEL-004",
        "XSC-005",
        "XSC-006",
        "NV-G-007"
      ]
    },
    {
      "name": "central-brain-governance",
      "unit": "central-brain-governance.service",
      "role": "shared-governance-precheck-socket-sample",
      "exec_contains": "central_brain_governance_daemon.py",
      "requires_runtime_directory": true,
      "write_paths": [
        "/run/central-brain",
        "/var/log/central-brain"
      ],
      "req_ids": [
        "DEL-002",
        "DEL-004",
        "XSC-005",
        "NV-G-002",
        "NV-G-004",
        "NV-G-005",
        "NV-G-006",
        "NV-G-007"
      ]
    },
    {
      "name": "central-brain-linux-ipc",
      "unit": "central-brain-linux-ipc.service",
      "role": "linux-ipc-protocol-binding-sample",
      "exec_contains": "central_brain_ipc_daemon.py",
      "requires_runtime_directory": true,
      "write_paths": [
        "/run/central-brain",
        "/var/log/central-brain"
      ],
      "req_ids": [
        "DEL-002",
        "DEL-004",
        "XSC-006",
        "NV-P-002",
        "NV-G-007"
      ]
    },
    {
      "name": "central-brain-linux-grpc",
      "unit": "central-brain-linux-grpc.service",
      "role": "linux-grpc-rpc-json-contract-sample",
      "exec_contains": "central_brain_grpc_server.py",
      "requires_runtime_directory": false,
      "write_paths": [
        "/var/log/central-brain"
      ],
      "req_ids": [
        "DEL-002",
        "DEL-004",
        "XSC-006",
        "NV-P-003",
        "NV-G-007"
      ]
    }
  ],
  "required_environment": [
    "CENTRAL_BRAIN_PORT",
    "CENTRAL_BRAIN_BASE_URL",
    "CENTRAL_BRAIN_IPC_SOCKET",
    "CENTRAL_BRAIN_GRPC_HOST",
    "CENTRAL_BRAIN_GRPC_PORT",
    "CENTRAL_BRAIN_GOVERNANCE_SOCKET",
    "CENTRAL_BRAIN_AUDIT_LOG",
    "CENTRAL_BRAIN_IPC_AUDIT_LOG",
    "CENTRAL_BRAIN_GRPC_AUDIT_LOG",
    "CENTRAL_BRAIN_GOVERNANCE_AUDIT_LOG"
  ],
  "hardening_required": [
    "NoNewPrivileges=true",
    "PrivateTmp=true",
    "PrivateDevices=true",
    "ProtectSystem=strict",
    "ProtectHome=true",
    "RestrictSUIDSGID=true",
    "LockPersonality=true",
    "Environment=PYTHONDONTWRITEBYTECODE=1"
  ],
  "non_goals": [
    "production package manager integration",
    "target distribution LSM policy",
    "real gRPC runtime replacement",
    "Driver/HAL development",
    "Safety Runtime implementation",
    "vehicle bus access",
    "virtualization implementation"
  ],
  "validation_commands": [
    "bash tools/check_central_brain_linux_package_profile.sh",
    "bash tools/check_central_brain_linux_systemd_hardening.sh",
    "bash tools/check_central_brain_delivery_docs.sh"
  ]
}
