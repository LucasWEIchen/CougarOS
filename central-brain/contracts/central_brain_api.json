{
  "name": "central-brain-api",
  "version": "0.1.9",
  "updated": "2026-07-04",
  "transport": {
    "prototype": "http-json",
    "linux_ipc_sample": "unix-domain-socket-json",
    "android_binder_sample": "AIDL service/client sample proxying the semantic gateway",
    "android_emulator_base_url": "http://10.0.2.2:8787",
    "host_base_url": "http://127.0.0.1:8787",
    "linux_ipc_socket": "/tmp/central_brain_gateway.sock"
  },
  "safety_states": [
    "normal",
    "degraded",
    "interlocked",
    "fault_isolated",
    "diagnostic_readonly"
  ],
  "endpoints": [
    {
      "method": "GET",
      "path": "/health",
      "description": "Returns system, service bus, and AI backend health."
    },
    {
      "method": "GET",
      "path": "/services",
      "description": "Returns registered prototype services and capabilities."
    },
    {
      "method": "GET",
      "path": "/context",
      "description": "Returns Uni Info Bus Context envelope for vehicle, user, and environment.",
      "req_ids": ["FW-U-001"]
    },
    {
      "method": "GET",
      "path": "/uib/context",
      "description": "Architecture-aligned alias for Uni Info Bus Context.",
      "req_ids": ["XSC-002", "FW-U-001", "NV-P-005"]
    },
    {
      "method": "GET",
      "path": "/state",
      "description": "Returns Uni Info Bus State envelope for system, services, NPU, vehicle, and safety state.",
      "req_ids": ["FW-U-002"]
    },
    {
      "method": "GET",
      "path": "/uib/state",
      "description": "Architecture-aligned alias for Uni Info Bus State.",
      "req_ids": ["XSC-002", "FW-U-002", "NV-P-005"]
    },
    {
      "method": "GET",
      "path": "/events/topics",
      "description": "Compatibility endpoint for Uni Info Bus event topics.",
      "req_ids": ["FW-U-003"]
    },
    {
      "method": "POST",
      "path": "/events/publish",
      "description": "Compatibility endpoint for publishing a mock Uni Info Bus event.",
      "req_ids": ["FW-U-003"]
    },
    {
      "method": "GET",
      "path": "/uib/events/topics",
      "description": "Returns Uni Info Bus Event topic contract, delivery model, and binding candidates.",
      "req_ids": ["XSC-002", "FW-U-003", "XSC-006", "NV-P-006"]
    },
    {
      "method": "POST",
      "path": "/uib/events/publish",
      "description": "Publishes a bounded-log mock event through the Uni Info Bus Event semantic envelope.",
      "req_ids": ["XSC-002", "FW-U-003", "XSC-006", "NV-P-006"]
    },
    {
      "method": "GET",
      "path": "/uib/events/recent",
      "description": "Returns recent Uni Info Bus Event records from the active mock log.",
      "req_ids": ["XSC-002", "FW-U-003", "XSC-006", "NV-P-006"]
    },
    {
      "method": "POST",
      "path": "/actions/request",
      "description": "Submits a policy-checked mock Action request.",
      "req_ids": ["FW-U-004"]
    },
    {
      "method": "POST",
      "path": "/service/invoke",
      "description": "Invokes a mock service through the Uni Info Bus service method entry.",
      "req_ids": ["FW-U-005", "FW-S-004"]
    },
    {
      "method": "GET",
      "path": "/soa/services",
      "description": "Returns SOA service entries with contract, permissions, safety state, and runtime registration metadata.",
      "req_ids": ["XSC-003", "FW-S-001", "FW-S-002", "FW-S-003", "FW-S-004", "NV-G-001", "NV-G-002", "NV-G-003"]
    },
    {
      "method": "POST",
      "path": "/soa/invoke",
      "description": "Architecture-aligned SOA service entry that applies mock Permission, Safety State, Lifecycle, and QoS checks before dispatch.",
      "req_ids": ["XSC-003", "FW-U-005", "FW-U-007", "FW-S-004", "FW-S-005", "NV-G-004", "NV-G-005"]
    },
    {
      "method": "GET",
      "path": "/governance/runtime",
      "description": "Returns Runtime & Governance state for Registry, Discovery, Schema, active fixed-window QoS, Policy, Lifecycle, and Audit.",
      "req_ids": ["XSC-005", "NV-G-001", "NV-G-002", "NV-G-003", "NV-G-004", "NV-G-005", "NV-G-006", "NV-G-007"]
    },
    {
      "method": "POST",
      "path": "/policy/evaluate",
      "description": "Architecture-aligned Policy entry for Permission and Safety State checks.",
      "req_ids": ["FW-U-007", "FW-S-005", "NV-G-005"]
    },
    {
      "method": "GET",
      "path": "/audit/recent",
      "description": "Returns recent Runtime & Governance audit records created by SOA calls; optional JSONL persistence is enabled by CENTRAL_BRAIN_AUDIT_LOG.",
      "req_ids": ["XSC-005", "NV-G-007", "DEL-002"]
    },
    {
      "method": "GET",
      "path": "/bindings",
      "description": "Returns Protocol Binding status for active REST, Android Binder/AIDL skeleton, Linux IPC/gRPC skeleton, and planned MQTT/SOME-IP/DDS paths.",
      "req_ids": ["XSC-006", "NV-P-001", "NV-P-002", "NV-P-003", "NV-P-004", "NV-P-005", "NV-P-006"]
    },
    {
      "method": "GET",
      "path": "/bindings/detail",
      "description": "Returns Protocol Binding contract artifacts for Android Binder/AIDL, Linux IPC, and Linux gRPC skeletons.",
      "req_ids": ["XSC-006", "NV-P-002", "NV-P-003", "DEL-001", "DEL-002"]
    },
    {
      "method": "GET",
      "path": "/native/adapters",
      "description": "Returns Native adapter registry for AIOS Kernel, SOA Service Adapter, Vehicle Signal Adapter, Model Runtime Adapter, and Security/Policy Adapter.",
      "req_ids": ["XSC-004", "NV-F-001", "NV-F-003", "NV-F-004", "NV-F-008", "NV-F-009", "NV-F-011"]
    },
    {
      "method": "GET",
      "path": "/native/adapters/detail",
      "description": "Returns Native adapter integration constraints, Android primary path, Linux sync path, and driver/HAL dependency notes.",
      "req_ids": ["XSC-004", "NV-F-001", "NV-F-003", "NV-F-004", "NV-F-005", "NV-F-008", "NV-F-009", "NV-F-011", "DEL-001", "DEL-002", "DEL-005"]
    },
    {
      "method": "GET",
      "path": "/tools",
      "description": "Returns mock Tool schemas for AI tool calls.",
      "req_ids": ["FW-U-006"]
    },
    {
      "method": "POST",
      "path": "/permission/check",
      "description": "Compatibility alias for Policy evaluation during Action/Tool/Service calls.",
      "req_ids": ["FW-U-007", "FW-S-005", "NV-G-005"]
    },
    {
      "method": "GET",
      "path": "/vehicle/state",
      "description": "Returns mock vehicle state with VSS-style signal names."
    },
    {
      "method": "GET",
      "path": "/npu/status",
      "description": "Returns external PCIe NPU runtime and discovery status."
    },
    {
      "method": "POST",
      "path": "/ai/infer",
      "description": "Submits a mock inference request.",
      "request": {
        "model": "string",
        "input": "object|string",
        "policy": {
          "safety_state_required": "normal",
          "timeout_ms": 2000
        }
      },
      "response": {
        "request_id": "string",
        "model": "string",
        "runtime": "mock-npu",
        "status": "ok|rejected|error",
        "result": "object",
        "metrics": {
          "queue_ms": "number",
          "inference_ms": "number"
        }
      }
    },
    {
      "method": "POST",
      "path": "/agent/plan",
      "description": "Planned: converts a user intent or scene trigger into a task graph."
    },
    {
      "method": "POST",
      "path": "/agent/execute",
      "description": "Planned: executes a policy-approved task graph."
    },
    {
      "method": "GET",
      "path": "/skills",
      "description": "Planned: returns available built-in and user-created skills."
    },
    {
      "method": "POST",
      "path": "/skills/{skill_id}/invoke",
      "description": "Planned: invokes a sandboxed skill after policy evaluation."
    },
    {
      "method": "POST",
      "path": "/memory/query",
      "description": "Planned: queries local vehicle/user memory for task context."
    },
    {
      "method": "POST",
      "path": "/privacy/evaluate",
      "description": "Planned: decides whether data can leave the vehicle and what redaction is required."
    }
  ],
  "envelope": {
    "trace_id": "string",
    "status": "ok|error",
    "error": "object|null",
    "payload": "object",
    "metrics": {
      "queue_ms": "number",
      "execution_ms": "number"
    }
  },
  "qos_decision": {
    "decision": "allow|deny|skipped",
    "service": "string",
    "priority": "vehicle-control|ai-task|diagnostic",
    "window_s": "number",
    "max_requests": "number",
    "current_count": "number",
    "retry_after_ms": "number",
    "req_ids": ["NV-G-004"]
  },
  "semantic_objects": {
    "context": [
      "Vehicle.Speed",
      "Vehicle.Cabin.HVAC.Station.Row1.Left.Temperature",
      "Vehicle.CurrentLocation",
      "User.DriverProfile",
      "Environment.Weather"
    ],
    "state": [
      "CentralBrain.Services",
      "CentralBrain.NPU",
      "CentralBrain.SafetyState",
      "CentralBrain.Network"
    ],
    "event": [
      "Vehicle.SignalChanged",
      "AI.ModelLoaded",
      "Service.HealthChanged",
      "Diagnostics.DtcChanged"
    ],
    "action": [
      "Cabin.SetTemperature",
      "Cabin.SetSeatMode",
      "Navigation.SetDestination",
      "Diagnostics.StartReadout"
    ],
    "tool": [
      "vehicle_state_query",
      "cabin_control",
      "diagnostic_trace",
      "npu_inference",
      "agent_task_planner",
      "memory_query",
      "policy_evaluate",
      "privacy_route"
    ],
    "permission": [
      "vehicle.read",
      "vehicle.control",
      "diagnostics.read",
      "diagnostics.write",
      "ai.infer",
      "ota.manage"
    ]
  }
}
