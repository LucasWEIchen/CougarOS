{
  "schema_version": 1,
  "profile_id": "android13-client2-multimodal-model-io-hmi-requirement-v1",
  "maturity": "requirement_defined_implementation_open",
  "requirement_ids": [
    "APP-004",
    "S2-HMI-003",
    "S2-HMI-007",
    "S2-HMI-008",
    "S2-MDL-002",
    "S2-OBS-002",
    "S2-SAF-001",
    "XSC-001",
    "XSC-005",
    "XSC-006",
    "DEL-001",
    "DEL-003",
    "DEL-004"
  ],
  "surface": {
    "host": "CLIENT2_LIVE_PIPELINE",
    "model_input_visible": true,
    "model_output_visible": true,
    "source_must_be_actual_model_exchange": true,
    "button_label_as_model_input_allowed": false,
    "fixture_as_live_input_allowed": false,
    "current_run_only": true,
    "clear_on_next_run": true
  },
  "text": {
    "render_directly": true,
    "maximum_code_points_per_item": 4096,
    "truncation_must_be_explicit": true,
    "input_label": "MODEL_INPUT",
    "output_label": "MODEL_OUTPUT"
  },
  "image": {
    "maximum_images_per_model_input": 1,
    "allowlisted_mime_types": [
      "image/png",
      "image/jpeg"
    ],
    "thumbnail_max_width_dp": 320,
    "thumbnail_max_height_dp": 180,
    "thumbnail_scale_type": "FIT_CENTER",
    "preserve_aspect_ratio": true,
    "crop_allowed": false,
    "upscale_above_native_size_allowed": false,
    "text_and_thumbnail_visible_together": true,
    "tap_opens_center_preview": true,
    "preview_max_screen_width_ratio": 0.9,
    "preview_max_screen_height_ratio": 0.85,
    "preview_scale_type": "FIT_CENTER",
    "tap_outside_dismisses_preview": true,
    "back_dismisses_preview": true,
    "tap_image_dismisses_preview": false
  },
  "driving_restriction": {
    "fullscreen_preview_allowed_states": [
      "PARKED",
      "IDLE"
    ],
    "fullscreen_preview_blocked_states": [
      "MOVING_RESTRICTED",
      "UNKNOWN_RESTRICTED",
      "FAULT_RESTRICTED"
    ],
    "blocked_state_keeps_bounded_thumbnail": true,
    "blocked_state_exposes_restriction_reason": true
  },
  "lifecycle_and_privacy": {
    "ui_process_memory_only": true,
    "room_persistence_allowed": false,
    "shared_preferences_persistence_allowed": false,
    "checkpoint_persistence_allowed": false,
    "raw_text_logging_allowed": false,
    "raw_image_logging_allowed": false,
    "github_evidence_payload_allowed": false,
    "decoded_bitmap_recycled_on_replace_or_destroy": true
  },
  "implementation_dependencies": [
    "versioned_frontend_transcript_and_image_sdk_binder",
    "transcript_image_aggregate_digest",
    "model_request_projection",
    "model_response_projection",
    "client2_immutable_model_io_state",
    "client2_thumbnail_and_center_preview_renderer",
    "android13_arm64_ui_interaction_evidence"
  ],
  "claim_state": {
    "requirement_defined": true,
