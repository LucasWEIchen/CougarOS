    "python3 -B tools/central_brain_android_hybrid_delivery.py verify --bundle-dir <bundle-dir>",
    "bash tools/install_central_brain_android_hybrid_delivery.sh --bundle-dir <bundle-dir> --serial <serial>",
    "bash tools/install_central_brain_android_hybrid_delivery.sh --bundle-dir <bundle-dir> --serial <serial> --execute --allow-debug-signing",
    "bash tools/install_central_brain_android_hybrid_delivery.sh --bundle-dir <bundle-dir> --serial <serial> --execute --allow-debug-signing --include-client2"
  ],
  "prohibited_operations": [
    "privilege escalation",
    "filesystem remount",
