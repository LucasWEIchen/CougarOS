      "vendor_npu_adapter_present": false
    },
    {
      "id": "event.runtime.empty",
      "blocker": "PRODUCTION_EVENT_RUNTIME_BLOCKED",
      "activation_allowed": false,
      "replacement_requires": "durable publisher sequence, callback Binder/broker owner and middleware evidence"
    },
    {
      "id": "memory.runtime.empty",
      "blocker": "PRODUCTION_MEMORY_RUNTIME_BLOCKED",
      "activation_allowed": false,
      "replacement_requires": "encrypted durable store, key lifecycle, consent/revocation and trusted retention clock"
    },
    {
      "id": "skill.governance.empty",
      "blocker": "PRODUCTION_SKILL_GOVERNANCE_BLOCKED",
      "activation_allowed": false,
      "replacement_requires": "artifact verifier, lifecycle/revoke/rollback, sandbox, authorities, audit and dispatcher"
    },
    {
      "id": "target.hardware.evidence.empty",
      "blocker": "TARGET_HARDWARE_NOT_VALIDATED",
      "activation_allowed": false,
      "replacement_requires": "physical Android 13 application pass plus subsystem and hardware qualification evidence"
    }
  ],
  "preserved_blockers": [
    "TARGET_SYSTEM_INTEGRATION_OWNER_UNRESOLVED",
    "PRODUCTION_EFFECT_DELIVERY_BLOCKED",
    "PRODUCTION_MODEL_RUNTIME_BLOCKED",
