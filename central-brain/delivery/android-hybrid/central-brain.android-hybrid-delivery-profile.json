    },
    {
      "id": "model.vendor.npu.empty",
      "blocker": "PRODUCTION_MODEL_RUNTIME_BLOCKED",
      "activation_allowed": false,
      "replacement_requires": "published vendor NPU SDK/ABI, lifecycle, memory, cancel, fault and physical-target evidence",
